{
  "experiment": {
    "name": "cifar10-fmca-av-reference",
    "family": "cifar_ssl"
  },
  "seed": 20260807,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "dataset": "cifar10",
    "root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/cifar10",
    "n_calibration": 2500,
    "n_val": 2500,
    "num_views": 8,
    "batch_size": 256,
    "num_workers": 8,
    "augmentation": {
      "min_scale": 0.08,
      "color_jitter_probability": 0.8,
      "color_jitter_strength": 0.5,
      "grayscale_probability": 0.2,
      "horizontal_flip_probability": 0.5
    }
  },
  "model": {
    "backbone": "resnet18_cifar",
    "backbone_width": 64,
    "feature_dim": 128,
    "head_hidden_dims": [512],
    "activation": "gelu",
    "parent_feature_source": "g",
    "parent_aggregation": "mean",
    "centered": true
  },
  "objective": {
    "name": "trace",
    "ridge": 0.001,
    "logdet_margin": 0.000001
  },
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "strategy": "auto",
    "max_epochs": 800,
    "precision": "32-true",
    "gradient_clip_val": 1.0,
    "deterministic": true,
    "log_every_n_steps": 20,
    "enable_progress_bar": false
  },
  "probe": {
    "n_val": 5000,
    "batch_size": 256,
    "num_workers": 8,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0,
    "max_epochs": 100,
    "accelerator": "gpu",
    "devices": 1,
    "precision": "32-true",
    "log_every_n_steps": 20,
    "enable_progress_bar": false
  }
}
