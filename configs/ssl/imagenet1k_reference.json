{
  "experiment": {
    "name": "imagenet1k-fmca-av-reference",
    "family": "vision_ssl"
  },
  "seed": 20260841,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "dataset": "imagenet1k",
    "root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/imagenet/ILSVRC",
    "val_labels": "/projects/common/imagenet/LOC_val_solution.csv",
    "train_manifest": "/projects/EEG-foundation-model/yinghao/FMCA-AV/imagenet/manifests/imagenet1k_train.tsv",
    "val_manifest": "/projects/EEG-foundation-model/yinghao/FMCA-AV/imagenet/manifests/imagenet1k_val.tsv",
    "n_calibration": 50000,
    "n_val": 50000,
    "num_views": 9,
    "batch_size": 64,
    "num_workers": 12,
    "prefetch_factor": 4,
    "augmentation": {
      "size": 224,
      "eval_resize": 256,
      "min_scale": 0.08,
      "max_scale": 1.0,
      "color_jitter_probability": 0.8,
      "color_jitter_strength": 0.5,
      "grayscale_probability": 0.2,
      "gaussian_blur_probability": 0.5,
      "horizontal_flip_probability": 0.5,
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    }
  },
  "model": {
    "backbone": "resnet50_imagenet",
    "feature_dim": 256,
    "head_hidden_dims": [2048, 2048],
    "activation": "gelu",
    "parent_feature_source": "g",
    "parent_aggregation": "concat",
    "centered": true
  },
  "objective": {
    "name": "trace",
    "ridge": 0.001,
    "logdet_margin": 0.000001
  },
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.3,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 2,
    "strategy": "ddp",
    "max_epochs": 100,
    "precision": "bf16-mixed",
    "gradient_clip_val": 1.0,
    "deterministic": true,
    "log_every_n_steps": 50,
    "enable_progress_bar": false
  },
  "probe": {
    "n_val": 50000,
    "batch_size": 512,
    "num_workers": 12,
    "prefetch_factor": 4,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0,
    "max_epochs": 90,
    "accelerator": "gpu",
    "devices": 2,
    "precision": "bf16-mixed",
    "log_every_n_steps": 50,
    "enable_progress_bar": false
  }
}
