{
  "experiment": {
    "name": "gatetin-tin200-v7_product_endpoint",
    "family": "cifar_gate",
    "status": "Tiny ImageNet-200 pilot, one seed: 200 classes at 64 pixels tests whether the dataset ordering seen from CIFAR-10 to CIFAR-100 continues. Disclosed deviations: downsampling stem and 100 epochs, so absolute numbers are NOT comparable to the CIFAR gates -- only the within-dataset contrasts are"
  },
  "seed": 20260816,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "dataset": "tinyimagenet200",
    "root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/tiny-imagenet-200",
    "n_calibration": 2500,
    "n_val": 2500,
    "batch_size": 256,
    "num_workers": 4,
    "view_tree": {
      "mode": "nested",
      "root": {
        "min_scale": 0.95,
        "max_scale": 1.0,
        "size": 64
      },
      "edges": [
        {
          "kind": "crop",
          "min_scale": 0.2,
          "max_scale": 1.0,
          "size": 64,
          "color_jitter_probability": 0.8,
          "color_jitter_strength": 0.5,
          "color_jitter_hue": true,
          "flip_probability": 0.5
        },
        {
          "kind": "crop",
          "min_scale": 0.4,
          "max_scale": 1.0,
          "size": 64,
          "grayscale_probability": 0.2
        }
      ],
      "children_per_edge": 4,
      "endpoint_descendants": 8,
      "flip_probability": 0.0
    },
    "image_size": 64,
    "augmentation": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ],
      "size": 64
    }
  },
  "model": {
    "backbone_width": 64,
    "level_stages": [
      1,
      2,
      3
    ],
    "feature_dim": 128,
    "head_hidden_dims": [
      512
    ],
    "activation": "gelu",
    "stem": "downsample"
  },
  "variant": "product_endpoint",
  "loss": {
    "alpha": 0.2,
    "beta": 128.0,
    "gamma": 1.0,
    "epsilon": 1e-06,
    "closure_stop_grad": false,
    "flat_recipe": "faithful_trace",
    "whitening_mode": "differentiable",
    "ridge": 0.001,
    "additive_recipe": "faithful_trace",
    "product_recipe": "faithful_bootstrap",
    "leaf_reward_weight": 1.0,
    "ema_target_momentum": 0.99
  },
  "objective_note": "additive variants take their maximizing per-edge sign inside the module; alpha/beta here only affect product_endpoint",
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "strategy": "auto",
    "max_epochs": 100,
    "precision": "32-true",
    "deterministic": true,
    "enable_progress_bar": false
  },
  "probe": {
    "n_val": 5000,
    "batch_size": 256,
    "num_workers": 4,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "epochs": 100
  }
}
