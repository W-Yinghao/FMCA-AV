  "n_calibration": 2500,
  "n_val": 2500,
  "num_views": 2,
  "batch_size": 256,
  "num_workers": 4,
  "augmentation": {
   "min_scale": 0.08,
   "color_jitter_probability": 0.8,
   "color_jitter_strength": 0.5,
