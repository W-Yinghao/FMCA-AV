{
  "experiment": {
    "name": "cifar10-ssl-matched-simclr",
    "family": "vision_ssl",
    "method": "simclr",
    "status": "Budget-matched external baseline for the five-question SSL wave (prereg SSL_FIVE_QUESTION_PREREG_FROZEN_20260910). ONLY the budget is aligned to the v8 gate: 200 epochs, batch 256, same CIFARResNet width 64, same dataset and root. The method's own objective, projector and augmentation recipe are left exactly as the screening config had them, so any gap is a budget-fair method difference and not a re-tuned baseline."
  },
  "seed": 20260850,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "dataset": "cifar10",
    "root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/cifar10",
    "n_calibration": 2500,
    "n_val": 2500,
    "num_views": 2,
    "batch_size": 256,
    "num_workers": 4,
    "augmentation": {
      "min_scale": 0.08,
      "color_jitter_probability": 0.8,
      "color_jitter_strength": 0.5,
      "grayscale_probability": 0.2,
      "horizontal_flip_probability": 0.5,
      "mean": [
        0.4914,
        0.4822,
        0.4465
      ],
      "std": [
        0.247,
        0.2435,
        0.2616
      ]
    }
  },
  "model": {
    "backbone": "resnet18_cifar",
    "backbone_width": 64,
    "projection_dim": 128,
    "projection_hidden_dims": [
      512,
      512
    ],
    "centered": true
  },
  "objective": {
    "name": "trace",
    "temperature": 0.2,
    "off_diagonal_weight": 0.0051,
    "invariance_weight": 25.0,
    "variance_weight": 25.0,
    "covariance_weight": 1.0
  },
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.03,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "strategy": "auto",
    "max_epochs": 200,
    "precision": "32-true",
    "gradient_clip_val": 1.0,
    "deterministic": true,
    "log_every_n_steps": 20,
    "enable_progress_bar": false
  },
  "probe": {
    "n_val": 5000,
    "batch_size": 256,
    "num_workers": 4,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "epochs": 100
  }
}
