{
  "experiment": {
    "name": "gate1paper-cifar100-alpha0",
    "family": "cifar_gate",
    "status": "The paper's SSL estimator (supplement Eq. 6-10, section Eq. 25): shared truncated inverse roots at tau=1e-3, plain ordered product as the composition, all trace scores in those same coordinates, no EMA, no stopped-gradient endpoint, gradients through the Gram transforms, empty retained set flags the batch. alpha=0: drops the adjacent-edge scores. CIFAR-100 replication: only dataset, root and the calibration budget differ from the CIFAR-10 arm."
  },
  "seed": 20260816,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "dataset": "cifar100",
    "root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/cifar100",
    "n_calibration": 10000,
    "n_val": 10000,
    "batch_size": 256,
    "num_workers": 4,
    "view_tree": {
      "mode": "nested",
      "root": {
        "min_scale": 0.95,
        "max_scale": 1.0,
        "size": 32
      },
      "edges": [
        {
          "kind": "crop",
          "min_scale": 0.2,
          "max_scale": 1.0,
          "size": 32,
          "color_jitter_probability": 0.8,
          "color_jitter_strength": 0.5,
          "color_jitter_hue": true,
          "flip_probability": 0.5
        },
        {
          "kind": "crop",
          "min_scale": 0.4,
          "max_scale": 1.0,
          "size": 32,
          "grayscale_probability": 0.2
        }
      ],
      "children_per_edge": 4,
      "endpoint_descendants": 8,
      "flip_probability": 0.0
    }
  },
  "model": {
    "backbone_width": 64,
    "level_stages": [
      1,
      2,
      3
    ],
    "feature_dim": 128,
    "head_hidden_dims": [
      512
    ],
    "activation": "gelu"
  },
  "variant": "paper_composition",
  "loss": {
    "alpha": 0.0,
    "beta": 128.0,
    "gamma": 1.0,
    "epsilon": 1e-06,
    "closure_stop_grad": false,
    "flat_recipe": "faithful_trace",
    "whitening_mode": "differentiable",
    "ridge": 0.001,
    "additive_recipe": "faithful_trace",
    "leaf_reward_weight": 1.0,
    "ema_target_momentum": 0.0,
    "spectral_tau": 0.001
  },
  "objective_note": "additive variants take their maximizing per-edge sign inside the module; alpha/beta here only affect product_endpoint",
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "strategy": "auto",
    "max_epochs": 200,
    "precision": "32-true",
    "deterministic": true,
    "enable_progress_bar": false
  },
  "probe": {
    "n_val": 5000,
    "batch_size": 256,
    "num_workers": 4,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "epochs": 100
  }
}
