{
  "experiment": {
    "name": "gaussian-cpu-smoke",
    "family": "gaussian_1d"
  },
  "seed": 20260807,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "n_train": 512,
    "n_calibration": 256,
    "n_val": 256,
    "n_test": 256,
    "noise_variance": 1.0,
    "num_views": 4,
    "batch_size": 128,
    "num_workers": 0
  },
  "model": {
    "feature_dim": 4,
    "hidden_dims": [32, 32],
    "activation": "gelu",
    "centered": true
  },
  "objective": {
    "name": "trace",
    "ridge": 0.001,
    "logdet_margin": 0.000001
  },
  "optimizer": {
    "learning_rate": 0.001,
    "weight_decay": 0.0
  },
  "trainer": {
    "accelerator": "cpu",
    "devices": 1,
    "max_epochs": 2,
    "precision": "32-true",
    "deterministic": true,
    "log_every_n_steps": 1,
    "enable_progress_bar": false
  }
}

