{
  "experiment": {
    "name": "gaussian-reference-trace",
    "family": "gaussian_1d"
  },
  "seed": 20260807,
  "output_root": "/projects/EEG-foundation-model/yinghao/FMCA-AV/experiment_runs",
  "data": {
    "n_train": 65536,
